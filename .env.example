# Salin file ini menjadi .env lalu sesuaikan nilainya.

# Koneksi PostgreSQL: postgresql://USER:PASSWORD@HOST:PORT/NAMA_DB
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/procurement

# Kunci rahasia sesi/CSRF. Ganti dengan teks acak yang panjang.
SECRET_KEY=ganti-dengan-teks-acak-yang-panjang

# Opsional: lokasi program Tesseract bila tidak ada di PATH.
# Windows : C:\Program Files\Tesseract-OCR\tesseract.exe
# macOS   : /opt/homebrew/bin/tesseract
# TESSERACT_CMD=
